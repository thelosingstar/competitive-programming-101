#include <bits/stdc++.h>
using namespace std;
int main(){
    int number = 0 , temp = 0 , score = 0;
    vector<int> array{} , copy{};
    unordered_map<int,int> freq;
    cin >> number;
    for(int i = 0; i < number; i++){
        cin >> temp;
        array.push_back(temp);
    }
    for(int i : array){
        freq[i]++;
    }
    for(auto const& [num , count] : freq){
        copy.push_back(count);
    }

    int size = copy.size();
    for(int i = 0 ; i < copy.size(); i++){
        if(number >= copy[i] + (copy[i] - 1)){
            score++; 
        }
        else{
            cout << "NO";
            break;
        }
    }
    

    if(score == size){
        cout << "YES";
    }
}

