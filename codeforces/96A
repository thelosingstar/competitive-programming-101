#include <bits/stdc++.h>
using namespace std;

int main(){
    string case1;
    cin >> case1;
    int streakO = 1; // we use 1 because the program will only create 6 pair when there are 7 identical variables

    for(int i = 0; i < case1.length(); i++){
        if(streakO >= 7){
            break;
        }
        else if(case1[i] == case1[i+1]){
            streakO ++;
        }
        else if(case1[i] != case1[i+1]){
            streakO = 1;
        }
    
    
    }
    if(streakO >= 7){
        cout << "YES";
        }
    else{
        cout << "NO";
        }
    
}
