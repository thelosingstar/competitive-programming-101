#include <bits/stdc++.h>
using namespace std;

int main(){
   vector<int> cases{};
   int test_cases = 0, x = 0 , y = 0, z = 0 , resultX = 0, resultY = 0, resultZ = 0;
   cin >> test_cases;
   for(int i = 0; i < test_cases; i++){
        cin >> x >> y >> z;
        cases.push_back(x);
        cases.push_back(y);
        cases.push_back(z);
   }

    for(int j = 0; j < test_cases * 3; j = j + 3){
        resultX = cases[j] + resultX;
    }
    for(int o = 1; o < test_cases * 3; o = o + 3){
        resultY = cases[o] + resultY;
    }
    for(int p = 2; p < test_cases * 3; p = p + 3){
        resultZ = cases[p] + resultZ;
    }
    
    if(resultX == 0 && resultY == 0 && resultZ == 0){
        cout << "YES";
    }
    else{
        cout << "NO";
    } 

}
