#include <bits/stdc++.h>
using namespace std;

int main() {
    string text;
    cin >> text;
    
    string target = "hello";
    int target_index = 0;
    
    for(int i = 0; i < text.length(); i++) {
        if (text[i] == target[target_index]) {
            target_index++;
        }
    
        if (target_index == 5) {
            break;
        }
    }
    if (target_index == 5) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
    
    return 0;
}
