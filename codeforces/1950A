#include <bits/stdc++.h>
using namespace std;

int main(){

    int test,case1,case2,case3;
    cin >> test;
    vector<int> numbers{};

    for(int i = 0; i < test; i++){
        cin >> case1 >> case2 >> case3;
        numbers.push_back(case1);
        numbers.push_back(case2);
        numbers.push_back(case3); // the value will be changed once for loop asks for new input

    }
    for(int j = 0; j < numbers.size(); j += 3){ // adding 3 instead of 1 because if j is 1 it will check the same triad comparing with another triad
        if(numbers[j] > numbers[j+1] && numbers[j + 1] > numbers[j+2]){
                cout << "STAIR" << endl;
            }
            else if(numbers[j + 1] > numbers[j] && numbers[j+1] > numbers[j+2]){
                cout << "PEAK" << endl;
            }
            else{
                cout << "NONE" << endl;
            }
    }
}
